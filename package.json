{
  "name": "@gamenalyze/ci-planner",
  "version": "0.5.0",
  "description": "Free CI waste and missing-check audits for GitHub Actions, with a conservative planner",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ci-planner": "bin/ci-planner.mjs"
  },
  "exports": {
    "./audit": "./src/audit.mjs",
    "./planner": "./src/planner.mjs",
    "./repository-audit": "./src/repository-audit.mjs",
    "./check-proposals": "./src/check-proposals.mjs",
    "./reports": "./src/reports.mjs",
    "./setup": "./src/setup.mjs",
    "./fix-pr": "./src/fix-pr.mjs",
    "./dependencies": "./src/dependencies.mjs",
    "./skip-validation": "./src/skip-validation.mjs",
    "./reuse": "./src/reuse.mjs",
    "./performance": "./src/performance.mjs",
    "./affected-tests": "./src/affected-tests.mjs",
    "./history": "./src/history.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "action.yml",
    "README.md",
    "LICENSE",
    "docs/",
    "examples/",
    "policy.schema.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "vendor/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "vendor:generate": "node scripts/vendor.mjs --write",
    "vendor:check": "node scripts/vendor.mjs",
    "sbom:check": "node scripts/vendor.mjs",
    "consumer:smoke": "npm ci --prefix examples/affected-tests-consumer --ignore-scripts --no-audit --no-fund && node scripts/consumer-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gamenalyze/ci-planner.git"
  },
  "bugs": {
    "url": "https://github.com/Gamenalyze/ci-planner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "yaml": "2.9.1"
  }
}

{
  "name": "@gamenalyze/ci-planner",
  "version": "0.1.0",
  "description": "Free CI audits and conservative pull request plans for GitHub Actions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ci-planner": "bin/ci-planner.mjs"
  },
  "exports": {
    "./audit": "./src/audit.mjs",
    "./planner": "./src/planner.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "action.yml",
    "README.md",
    "LICENSE",
    "docs/",
    "examples/",
    "policy.schema.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/ci-planner.mjs && node --check src/planner.mjs && node --check src/audit.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gamenalyze/ci-planner.git"
  },
  "bugs": {
    "url": "https://github.com/Gamenalyze/ci-planner/issues"
  }
}
